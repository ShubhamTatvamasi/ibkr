---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Full-screen app: no site header/footer (the app draws its own shell). */
  bare?: boolean;
}
const {
  title,
  description = 'Private, in-browser Indian tax reports (Schedule FA, CG, OS, FSI/TR, Form 67) from Interactive Brokers statements.',
  bare = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname.replace(/\/?$/, '/');
const nav = [
  { href: base, label: 'Tool' },
  { href: `${base}guide/`, label: 'Flex Query guide' },
  { href: `${base}method/`, label: 'Method' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1216" media="(prefers-color-scheme: dark)" />
    {/* Only same-origin network access: statements cannot be sent anywhere. Off in dev (HMR websocket). */}
    {import.meta.env.PROD && (
      <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'" />
    )}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('ibkr-tax:theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    {bare ? (
      <slot />
    ) : (
      <>
        <header class="site-header">
          <div class="wrap">
            <a class="brand" href={base}><span class="brand-mark">₹</span><span>IBKR India Tax</span></a>
            <nav class="site-nav">
              {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
            </nav>
          </div>
        </header>
        <main class="wrap">
          <slot />
        </main>
        <footer class="site-footer">
          <div class="wrap">Calculation aid, not tax advice — review every figure with your Chartered Accountant. Exchange rates: SBI TT buying rates. Your statements are processed only in your browser.</div>
        </footer>
      </>
    )}
  </body>
</html>
