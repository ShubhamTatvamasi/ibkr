---
import { ICONS } from '../lib/ui/icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
---
<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name] ?? ''}
/>
